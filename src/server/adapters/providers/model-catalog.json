{
  "version": 2,
  "updatedAt": "2026-10-27",
  "note": "内置模型能力对照表。match 是正则（对模型 id 小写后匹配，按数组顺序取第一条命中）。数值是该模型公开文档的能力上限，仅作表单默认值，用户可手改。用户覆盖请写 ~/.agentbot/model-catalog.json，不要改这个文件。",
  "sources": [
    "DeepSeek 官方定价页（2026-10）：deepseek-flash / deepseek-v4-pro 1M 上下文 / 384K 输出",
    "Anthropic 上下文文档：1M 窗口系列单请求上限 128K 输出；其余 200K 窗口",
    "其余条目为公开文档的保守取值；供应商若未上报，以拉取到的模型清单为准"
  ],
  "models": [
    { "match": "^deepseek.*v4.*flash|^deepseek-flash", "contextWindow": 1000000, "maxOutputTokens": 384000, "note": "DeepSeek 官方" },
    { "match": "^deepseek.*v4.*pro", "contextWindow": 1000000, "maxOutputTokens": 384000, "note": "DeepSeek 官方" },
    { "match": "^deepseek.*(v4|v3\\.2)", "contextWindow": 1000000, "maxOutputTokens": 131072, "note": "V4 系列保守值" },
    { "match": "deepseek-reasoner|deepseek-r1", "contextWindow": 128000, "maxOutputTokens": 65536 },
    { "match": "^deepseek", "contextWindow": 128000, "maxOutputTokens": 8192 },

    { "match": "claude.*(opus|sonnet).*5", "contextWindow": 1000000, "maxOutputTokens": 128000, "note": "Anthropic 1M 系列" },
    { "match": "claude.*opus.*4", "contextWindow": 200000, "maxOutputTokens": 64000 },
    { "match": "claude.*sonnet.*4", "contextWindow": 200000, "maxOutputTokens": 64000 },
    { "match": "claude.*haiku.*4", "contextWindow": 200000, "maxOutputTokens": 32000 },
    { "match": "claude-3[-.]7-sonnet", "contextWindow": 200000, "maxOutputTokens": 64000 },
    { "match": "claude-3[-.]5", "contextWindow": 200000, "maxOutputTokens": 8192 },
    { "match": "claude-3-", "contextWindow": 200000, "maxOutputTokens": 4096 },
    { "match": "^claude", "contextWindow": 200000, "maxOutputTokens": 8192 },

    { "match": "gpt-5\\.[1-9]", "contextWindow": 400000, "maxOutputTokens": 128000 },
    { "match": "^gpt-5", "contextWindow": 400000, "maxOutputTokens": 128000 },
    { "match": "gpt-4\\.1", "contextWindow": 1047576, "maxOutputTokens": 32768 },
    { "match": "gpt-4o-mini", "contextWindow": 128000, "maxOutputTokens": 16384 },
    { "match": "gpt-4o", "contextWindow": 128000, "maxOutputTokens": 16384 },
    { "match": "gpt-4-turbo", "contextWindow": 128000, "maxOutputTokens": 4096 },
    { "match": "^gpt-4", "contextWindow": 8192, "maxOutputTokens": 4096 },
    { "match": "^o[134](-|$)", "contextWindow": 200000, "maxOutputTokens": 100000 },

    { "match": "gemini-3", "contextWindow": 1048576, "maxOutputTokens": 65536 },
    { "match": "gemini-2\\.5", "contextWindow": 1048576, "maxOutputTokens": 65536 },
    { "match": "gemini-2\\.0", "contextWindow": 1048576, "maxOutputTokens": 8192 },
    { "match": "gemini-1\\.5", "contextWindow": 1048576, "maxOutputTokens": 8192 },
    { "match": "^gemini", "contextWindow": 128000, "maxOutputTokens": 8192 },

    { "match": "qwen3.*max|qwen.*max", "contextWindow": 262144, "maxOutputTokens": 32768 },
    { "match": "qwen3", "contextWindow": 262144, "maxOutputTokens": 16384 },
    { "match": "^qwen", "contextWindow": 32768, "maxOutputTokens": 8192 },

    { "match": "glm-5", "contextWindow": 204800, "maxOutputTokens": 32768 },
    { "match": "glm-4\\.[5-9]|glm-4-plus", "contextWindow": 128000, "maxOutputTokens": 16384 },
    { "match": "^glm", "contextWindow": 128000, "maxOutputTokens": 4096 },

    { "match": "kimi.*k2", "contextWindow": 262144, "maxOutputTokens": 32768 },
    { "match": "kimi|moonshot", "contextWindow": 128000, "maxOutputTokens": 8192 },

    { "match": "llama-?4", "contextWindow": 1048576, "maxOutputTokens": 32768 },
    { "match": "llama-?3\\.[1-9]", "contextWindow": 128000, "maxOutputTokens": 8192 },
    { "match": "^llama", "contextWindow": 8192, "maxOutputTokens": 4096 },
    { "match": "mistral|mixtral", "contextWindow": 32768, "maxOutputTokens": 8192 }
  ]
}
